{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.local/schemas/payloads/interest.capitalized.json",
  "title": "InterestCapitalizedPayload",
  "description": "Kapitalizacja odsetek na rachunku (gross, podatek, net).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "accountId",
    "customerId",
    "gross",
    "tax",
    "net",
    "periodStart",
    "periodEnd"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Adres odbiorcy wiadomości — jedyne PII poza identyfikatorami; obecne tylko w zdarzeniach konsumowanych przez notifications"
    },
    "iban": {
      "type": "string",
      "minLength": 15,
      "maxLength": 34,
      "description": "IBAN bez spacji"
    },
    "gross": {
      "$ref": "../money.json"
    },
    "tax": {
      "$ref": "../money.json"
    },
    "net": {
      "$ref": "../money.json"
    },
    "periodStart": {
      "type": "string",
      "format": "date"
    },
    "periodEnd": {
      "type": "string",
      "format": "date"
    }
  }
}
