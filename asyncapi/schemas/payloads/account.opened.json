{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.local/schemas/payloads/account.opened.json",
  "title": "AccountOpenedPayload",
  "description": "Otwarto rachunek. notifications → mail z numerem rachunku.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "accountId",
    "customerId",
    "iban",
    "productCode"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Adres odbiorcy wiadomości — jedyne PII poza identyfikatorami; obecne tylko w zdarzeniach konsumowanych przez notifications"
    },
    "iban": {
      "type": "string",
      "minLength": 15,
      "maxLength": 34,
      "description": "IBAN bez spacji"
    },
    "productCode": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    }
  }
}
