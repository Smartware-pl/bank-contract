{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.local/schemas/payloads/customer.created.json",
  "title": "CustomerCreatedPayload",
  "description": "Utworzono klienta. notifications → mail powitalny.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "customerId",
    "email"
  ],
  "properties": {
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Adres odbiorcy wiadomości — jedyne PII poza identyfikatorami; obecne tylko w zdarzeniach konsumowanych przez notifications"
    },
    "fullName": {
      "type": "string",
      "description": "Do zwrotu grzecznościowego w mailu"
    }
  }
}
